DB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hackathon_db?appName=Cluster0
# Safety check used by database preparation scripts. Production defaults to hackathon_db.
EXPECTED_DB_NAME=hackathon_db
# Local development additionally pins this to the DevCluster hostname.
EXPECTED_DB_HOST=
EMAIL=your-sender@gmail.com
FRONT_END_URL=http://localhost:3000/
NODE_ENV=development
# Legacy setting: unused by Clerk authentication.
DEV_EMAIL_VERIFICATION=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000
# Legacy setting: unused by Clerk authentication.
JWT_SECRET=
# Use keys from the same Clerk instance for these two runtime settings.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production secret key (sk_live_...) for the one-time migration only.
MIGRATION_CLERK_SECRET_KEY=
# Application cycle. Keep the season stable after accepting applications.
APPLICATION_SEASON=2027
APPLICATIONS_OPEN=true
# Optional ISO timestamp with timezone; blank means no configured deadline.
APPLICATION_DEADLINE=
PORTAL_ADMIN_ONLY=false
